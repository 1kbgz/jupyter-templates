{
  "name": "jupyter-templates",
  "version": "0.1.1",
  "description": "Support for notebook templates in jupyter and jupyterlab",
  "repository": "git@github.com:1kbgz/jupyter-templates.git",
  "author": "the jupyter-templates authors <dev@1kbgz.com>",
  "license": "Apache-2.0",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "main": "lib/index.js",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.css"
  ],
  "jupyterlab": {
    "extension": "lib/index.js",
    "outputDir": "../jupyter_templates/labextension",
    "discovery": {
      "server": {
        "base": {
          "name": "jupyter_templates"
        },
        "managers": [
          "pip"
        ]
      }
    }
  },
  "scripts": {
    "build:babel": "babel src/ --source-maps --out-dir lib/",
    "build:extension": "mkdirp ../jupyter_templates/extension/ && cpy --flat 'src/extension/*' '../jupyter_templates/extension/'",
    "build:nbextension": "mkdirp ../jupyter_templates/nbextension/static/ && cpy --flat 'src/notebook/main.js' '../jupyter_templates/nbextension/static/' && cpy --flat 'style/icon.svg' '../jupyter_templates/nbextension/static/'",
    "build:labextension": "rimraf ../jupyter_templates/labextension && jupyter labextension build .",
    "build": "pnpm clean && pnpm build:babel && pnpm build:extension && pnpm build:labextension && pnpm build:nbextension",
    "clean": "rimraf lib",
    "fix": "oxlint --fix src/ tests/ && oxfmt --write \"src/**/*.js\" \"tests/**/*.js\"",
    "lint": "oxlint src/ tests/ && oxfmt --check \"src/**/*.js\" \"tests/**/*.js\"",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm run build",
    "test": "jest --coverage --collectCoverageFrom=src/*.{js}"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.7",
    "@jupyterlab/apputils": "^4.6.7",
    "@jupyterlab/filebrowser": "^4.5.7",
    "@jupyterlab/launcher": "^4.5.7",
    "@jupyterlab/mainmenu": "^4.5.7",
    "@jupyterlab/notebook": "^4.5.7",
    "@jupyterlab/services": "^7.5.10",
    "@lumino/disposable": "^2.1.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.5",
    "@jupyterlab/builder": "^4.5.7",
    "babel-jest": "^30.4.1",
    "cpy-cli": "^7.0.0",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "jest-transform-css": "^6.0.3",
    "mkdirp": "^3.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rimraf": "^6.1.3"
  }
}
